{
  "apiVersion": 1,
  "id": "at365.chatcodex",
  "name": "Applet.ChatCodex.at365",
  "displayName": "ChatCodex",
  "version": "0.6.6",
  "minimumHostVersion": "0.86.13",
  "runtime": "node",
  "entry": "src/applet.cjs",
  "description": "Codexとチャットし、既存のMCP接続でAppDockを操作します。",
  "capabilities": ["pages", "storage", "appdock-api", "settings"],
  "settings": [
    {
      "key": "sendKey", "title": "メッセージの送信キー", "type": "select", "default": "ctrl-enter",
      "description": "すぐに切り替わります。Ctrl+Enterの場合はEnterで改行します。どちらもShift+Enterで改行でき、日本語の変換確定中は送信しません。",
      "options": [{"value":"ctrl-enter","label":"Ctrl+Enter（既定）"},{"value":"enter","label":"Enter"}]
    },
    {
      "key": "chatDisplayMode", "title": "チャットの表示内容", "type": "select", "default": "inherit",
      "description": "既定は以前の選択を引き継ぎ、未設定なら通常です。通常／詳細を選んで切り替えられます。詳細は初期指示・ツール・確認を表示し、古い情報から整理して最新を残します。過去の通信は追加取得しません。",
      "options": [{"value":"inherit","label":"既定（以前の選択／通常）"},{"value":"normal","label":"通常"},{"value":"detail","label":"詳細"}]
    },
    {
      "key": "wireLogEnabled", "title": "通信ログを表示（開発者向け）", "type": "boolean", "default": false,
      "description": "通常／詳細の選択と独立して送受信JSONを表示します。古い通信ログから整理して最新を残し、詳細情報の保持枠には影響しません。秘密値等は伏せ、ログファイルは作りません。"
    },
    {
      "key": "sendOperationInstructions", "title": "AppDockの操作指示を送る", "type": "boolean", "default": true,
      "description": "次の新しいチャットから適用します。既存MCPの使用、接続先・revisionの確認、設定JSONの直接編集禁止などの指示を送ります。オフでもCodex自身の指示やAGENTS.mdは残ります。"
    },
    {
      "key": "memoryMode", "title": "既存のCodexメモリを利用", "type": "select", "default": "inherit",
      "description": "次の新しいチャットから自動注入を制御します。メモリ機能そのものはCodex設定に従い、要約本文の表示やツールによるファイル読取りの禁止を意味しません。",
      "options": [{"value":"inherit","label":"Codexの設定に従う"},{"value":"include","label":"利用する"},{"value":"exclude","label":"利用しない"}]
    }
  ],
  "commands": [
    { "id": "at365.chatcodex.open", "title": "Codexチャットを開く", "activateOnExecute": true }
  ],
  "pages": [
    { "id": "main", "title": "Codexチャット", "source": "local", "ui": "web/index.html", "openCommand": "at365.chatcodex.open", "defaultDisplay": "page" }
  ],
  "pageActions": [
    { "id": "chat.read", "parameters": { "generation": "number", "after": "number" } },
    { "id": "chat.connect", "parameters": { "generation": "number" } },
    { "id": "chat.send", "parameters": { "generation": "number", "requestId": "string", "text": "string" } },
    { "id": "chat.select", "parameters": { "generation": "number", "model": "string", "effort": "string" } },
    { "id": "chat.approval", "parameters": { "generation": "number", "mode": "string" } },
    { "id": "chat.new", "parameters": { "generation": "number" } },
    { "id": "chat.stop", "parameters": { "generation": "number" } },
    { "id": "chat.respond", "parameters": { "generation": "number", "requestId": "string", "response": "string" } },
    { "id": "chat.usage", "parameters": { "generation": "number" } },
    { "id": "chat.resume", "parameters": { "generation": "number", "requestId": "string", "pauseId": "string" } },
    { "id": "chat.compact", "parameters": { "generation": "number", "requestId": "string", "recoveryId": "string" } },
    { "id": "chat.context-continue", "parameters": { "generation": "number", "requestId": "string", "recoveryId": "string" } },
    { "id": "chat.handoff", "parameters": { "generation": "number", "recoveryId": "string" } },
    { "id": "chat.restore-light", "parameters": { "generation": "number" } },
    { "id": "chat.recover", "parameters": { "generation": "number", "requestId": "string", "recoveryId": "string" } },
    { "id": "chat.note-save", "parameters": { "generation": "number", "threadId": "string", "noteId": "string", "requestId": "string", "text": "string" } },
    { "id": "chat.note-handoff", "parameters": { "generation": "number", "threadId": "string", "noteId": "string" } }
  ]
}
